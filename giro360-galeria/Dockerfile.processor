# Container de processamento (Cloudflare Containers): Node + FFmpeg + sharp + SDK do Rekognition.
# Não acessa o banco: recebe pedidos do Worker, lê/grava no R2 e devolve resultados.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false && npm install --no-save tsx@4 && npm cache clean --force
COPY tsconfig.json ./
COPY src/lib ./src/lib
COPY src/processor ./src/processor
COPY scripts/load-env.ts ./scripts/load-env.ts
ENV NODE_ENV=production PORT=8080 PROCESSOR_WORK_DIR=/tmp/giro360-work
EXPOSE 8080
CMD ["npx", "tsx", "src/processor/server.ts"]
