# ---------------------------------------------------------------- aplicação
# development | local | staging | production  (em production o reconhecimento simulado é recusado)
APP_ENV=local
# Endereço público do site (usado nos links e QR Codes). Ex.: https://galeria.giro360.com.br
APP_URL=http://localhost:3000
# Gere com: openssl rand -base64 48   (nunca reutilize entre ambientes)
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
# true quando atrás de proxy (Railway, Cloudflare) para limitar tentativas por IP real
TRUST_PROXY=false

# ---------------------------------------------------------------- banco
DATABASE_URL=postgresql://giro:giro@localhost:5432/giro360

# ---------------------------------------------------------------- armazenamento (S3 / Cloudflare R2 / MinIO)
# Local (MinIO do docker compose):
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=giro360-midias
S3_ACCESS_KEY_ID=giroadmin
S3_SECRET_ACCESS_KEY=giroadmin-secret
# Origens que podem enviar direto ao bucket (CORS). Padrão: APP_URL
# S3_CORS_ORIGINS=https://galeria.giro360.com.br
# Cloudflare R2 (produção):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------- reconhecimento facial
# none = site sem busca por selfie | mock = simulado (só demonstração) | rekognition = Amazon Rekognition
FACE_PROVIDER=mock
# Para rekognition: credenciais de um usuário IAM com permissões só de Rekognition (ver docs/aws-rekognition.md)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
FACE_MATCH_THRESHOLD=90
FACE_MAX_RESULTS=60
VIDEO_FRAME_INTERVAL_SEC=1.5
VIDEO_MAX_FRAMES=24

# ---------------------------------------------------------------- prazos e limites
ACCESS_DAYS=30
ACCESS_EXTENSION_DAYS=30
FACE_DAYS=90
UPLOAD_MAX_PHOTO_MB=50
UPLOAD_MAX_VIDEO_MB=8192
MULTIPART_PART_MB=16

# ---------------------------------------------------------------- atendimento
WHATSAPP_NUMBER=
REMOVAL_REQUEST_CONTACT=privacidade@giro360.com.br

# ---------------------------------------------------------------- primeiro acesso ao painel (npm run admin:create)
ADMIN_EMAIL=admin@giro360.local
ADMIN_PASSWORD=troque-esta-senha
