# Variáveis do ambiente local (wrangler dev / npm run preview e scripts). Copie para .dev.vars.
APP_ENV=development
APP_URL=http://localhost:8787
SESSION_SECRET=dev-segredo-local-com-mais-de-32-caracteres-123
# MinIO local (docker compose up -d)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=giro360-midias
S3_ACCESS_KEY_ID=giroadmin
S3_SECRET_ACCESS_KEY=giroadmin-secret
