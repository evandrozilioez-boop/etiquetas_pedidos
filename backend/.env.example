PORT=3333
HOST=0.0.0.0
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etiquetas_pedidos?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"

# Adaptador de impressao: "network" envia o ZPL via socket TCP (porta 9100 padrao Zebra),
# "mock" apenas simula o envio (util para desenvolvimento/homologacao sem impressora fisica).
PRINT_ADAPTER="mock"

# Quando definido, o backend serve o build do frontend (SPA) direto deste
# processo/porta, no mesmo dominio - usado no empacotamento single-PC
# (instalador Windows). Deixe vazio em desenvolvimento (frontend roda via
# Vite em processo/porta separados).
FRONTEND_DIST_PATH=
