PORT=3333
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etiquetas_pedidos?schema=public"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"

# Adaptador de impressao: "network" envia o ZPL via socket TCP (porta 9100 padrao Zebra),
# "mock" apenas simula o envio (util para desenvolvimento/homologacao sem impressora fisica).
PRINT_ADAPTER="mock"
