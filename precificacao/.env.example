# Porta do servidor (API + interface compilada)
PORT=3340

# demo | producao. Sem credenciais o app sempre roda em demonstração.
ML_MODE=producao

# Opção A: token de acesso já emitido (expira em ~6 h)
ML_ACCESS_TOKEN=

# Opção B (recomendada): renovação automática do token no servidor
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Tempo (minutos) que uma consulta de tarifa pode ser reutilizada para o MESMO preço
ML_CACHE_MINUTOS=30
